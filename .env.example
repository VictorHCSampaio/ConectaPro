DB_URL=https://db_url
DB_USERNAME=postgres.SEU_PROJECT_REF
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=https://seu-front.vercel.app

# Chave AES-256 para criptografia do segredo TOTP no banco. Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Chave secreta para assinatura JWT (HMAC-SHA256). Mínimo 32 bytes. Gere com: openssl rand -base64 64
JWT_SECRET=
# Tempo de expiração do access token em minutos (padrão: 30)
JWT_EXPIRACAO_MINUTOS=30
# Tempo de expiração do token de pré-autenticação (2FA) em minutos (padrão: 5)
JWT_PRE_AUTH_EXPIRACAO_MINUTOS=5

SENDGRID_API_KEY=
MAIL_FROM_NAME=ConectaPro
MAIL_FROM=noreply@conectapro.com.br
ADMIN_EMAIL=admin1.conectapro@gmail.com

# URL base do frontend para link de reset de senha
FRONTEND_BASE_URL=http://localhost:5173

# Mercado Pago (obrigatorio: a aplicacao nao sobe sem o access token)
MERCADOPAGO_ACCESS_TOKEN=
# Chave secreta do webhook (painel do Mercado Pago) para validar a assinatura X-Signature
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_URL_SUCESSO=http://localhost:5173/pagamento/sucesso
MERCADOPAGO_URL_FALHA=http://localhost:5173/pagamento/falha
MERCADOPAGO_URL_PENDENTE=http://localhost:5173/pagamento/pendente
