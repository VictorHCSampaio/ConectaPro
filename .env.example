DB_URL=https://db_url
DB_USERNAME=postgres.SEU_PROJECT_REF
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=https://seu-front.vercel.app

# Chave AES-256 para criptografia do segredo TOTP no banco. Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Chave secreta para assinatura JWT (HMAC-SHA256). Mínimo 32 bytes. Gere com: openssl rand -base64 64
JWT_SECRET=
# Tempo de expiração do access token em minutos (padrão: 30)
JWT_EXPIRACAO_MINUTOS=30
# Tempo de expiração do token de pré-autenticação (2FA) em minutos (padrão: 5)
JWT_PRE_AUTH_EXPIRACAO_MINUTOS=5
